# Supabase project URL and anon (public) key — used by src/lib/supabase.ts
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Direct Postgres URI for Drizzle / maintenance scripts — put in apps/server/.env (not the Expo app).
# Supabase: Dashboard → Project Settings → Database. Use for: migrations, clear-wiki-data, reset:wiki.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
