# Supabase project URL and anon (public) key — used by src/lib/supabase.ts
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Postgres connection for Drizzle (API routes only). NOT derivable from the anon key.
# Supabase → Project Settings → Database → Connection string → URI (Transaction pooler, port 6543).
# Must start with postgres:// or postgresql:// (not https://). Encode special chars in the password.
# Before first push: run scripts/supabase-enable-pgvector.sql in Supabase SQL Editor.
# If `drizzle-kit push` hangs on "Pulling schema", try the direct DB URL (port 5432), not only the pooler (6543).
DATABASE_URL=

# Optional: OpenAI + Jina for AI routes (server-side)
OPENAI_API_KEY=
JINA_API_KEY=

# Medium (paywall / member posts): Firecrawl scrape v2 — used when URL matches Medium hosts (see extract-content-medium-firecrawl.ts)
FIRECRAWL_API_KEY=
# Optional: Medium session cookie string for Firecrawl request headers (member content)
FIRECRAWL_MEDIUM_COOKIE=
# Optional: Firecrawl browser profile name (persisted login; alternative to raw cookie)
FIRECRAWL_MEDIUM_PROFILE=mymemory-medium
# Optional: extra JSON headers object, e.g. {"Authorization":"Bearer ..."}
FIRECRAWL_MEDIUM_HEADERS_JSON=
# Optional: comma-separated hostnames/suffixes treated as Medium (e.g. towardsdatascience.com,readmedium.com)
FIRECRAWL_MEDIUM_EXTRA_HOSTS=
# Optional: override default https://api.firecrawl.dev/v2/scrape
# FIRECRAWL_API_URL=
