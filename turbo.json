{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_DIRECT_URL",
    "DATABASE_URL",
    "EXPO_PUBLIC_API_URL",
    "FIRECRAWL_API_KEY",
    "FIRECRAWL_MEDIUM_PROFILE",
    "JINA_API_KEY",
    "OPENAI_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".expo/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
